# ═══════════════════════════════════════════════════════════════
#  LUMIA — Environment Variables
#  Copy file này, đặt tên .env.local để chạy local
#  Trên Vercel: Settings → Environment Variables → import file này
# ═══════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────────
# Dashboard: https://supabase.com/dashboard → Project Settings → API

# 1. Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# 2. Anon / Publishable key  (safe — dùng ở browser)
#    Supabase mới:  "Publishable" tab → sb_publishable_...
#    Supabase cũ:   "anon public"     → eyJh...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# 3. Service Role / Secret key  (NEVER expose — chỉ server)
#    Supabase mới: "Secret" tab → sb_secret_...
#    Supabase cũ:  "service_role"    → eyJh...
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── App URL ──────────────────────────────────────────────────────
# URL production của app — dùng để build absolute URL cho callback PayOS
NEXT_PUBLIC_APP_URL=https://www.lumia.com.vn

# ── LLM / AI ─────────────────────────────────────────────────────
# OpenAI hoặc bất kỳ provider nào tương thích OpenAI
LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1   # bỏ comment nếu dùng provider khác
LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=512
# LLM_TEMPERATURE=0.7

# ── PayOS ────────────────────────────────────────────────────────
# Lấy tại: https://my.payos.vn → Tài khoản → Tích hợp API
#
# Bước setup:
#   1. Điền 3 biến bên dưới
#   2. Set DEMO_MODE=false (hoặc xóa dòng DEMO_MODE)
#   3. Set PAYOS_WEBHOOK_URL = https://<domain>/api/payos/webhook
#   4. Deploy lên server
#   5. Gọi POST /api/admin/payos-webhook (dùng tài khoản admin)
#      để đăng ký webhook URL với PayOS — chỉ cần làm 1 lần sau deploy

# Client ID — tìm ở tab "Tích hợp API" của portal PayOS
PAYOS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# API Key — tìm ở tab "Tích hợp API" (mục "API Key")
PAYOS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Checksum Key — tìm ở tab "Tích hợp API" (mục "Checksum Key")
PAYOS_CHECKSUM_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook URL — phải là URL public HTTPS, trỏ đúng vào /api/payos/webhook
# PayOS sẽ POST vào URL này sau mỗi giao dịch thành công/thất bại
PAYOS_WEBHOOK_URL=https://www.lumia.com.vn/api/payos/webhook

# ── Bảo mật / Cron ───────────────────────────────────────────────
# Tạo: openssl rand -hex 32
CRON_SECRET=

# ── Demo mode ────────────────────────────────────────────────────
# true  → bỏ qua PayOS, trả về URL checkout giả (dùng khi dev local)
# false → kết nối PayOS thật (bắt buộc khi production)
DEMO_MODE=false

# ── Analytics & SEO (tuỳ chọn) ───────────────────────────────────
#
# 1. Google Analytics 4
#    Lấy tại: https://analytics.google.com → Admin → Data Streams → Web
#    → "Measurement ID" dạng G-XXXXXXXXXX
#    Bỏ trống = không nhúng gtag.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
#
# 2. Google Search Console
#    Lấy tại: https://search.google.com/search-console
#    → Add property (URL prefix) → Verify → chọn cách "HTML tag"
#    → copy phần content="..." của thẻ meta google-site-verification
#    Sau khi verify xong, submit sitemap: https://<domain>/sitemap.xml
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 3. Vercel Web Analytics + Speed Insights
#    Không cần biến env — bật ở Vercel Dashboard → Project → Analytics
#    (và tab Speed Insights). Script tự no-op khi chạy ngoài Vercel.
#
# 4. Kill switch chung — set true để tắt cả GA lẫn Vercel Analytics
# NEXT_PUBLIC_ANALYTICS_DISABLED=false

# ── Báo cáo trong trang admin (tuỳ chọn) ─────────────────────────
# Chỉ cần khi muốn xem số liệu GA4 + Search Console ngay trong /admin → tab
# "Báo cáo". Dùng service account của Google Cloud (không phải OAuth user).
#
# Tạo service account:
#   1. https://console.cloud.google.com → IAM & Admin → Service Accounts → Create
#   2. Keys → Add key → JSON → tải file về
#   3. APIs & Services → Library → bật CẢ HAI (mỗi API phải bật riêng):
#        • Google Analytics Data API   (analyticsdata.googleapis.com)
#        • Google Search Console API   (searchconsole.googleapis.com)
#   4. GA4: Admin → Property access management → thêm email service account
#      với quyền Viewer
#   5. Search Console: Settings → Users and permissions → thêm email đó
#      với quyền Full hoặc Restricted
#
#   Bước 3 và 4-5 tách rời: bật API cho phép GỌI, cấp quyền cho phép ĐỌC.
#   Thiếu bước nào cũng lỗi, và hai lỗi trông rất khác nhau.
#
# Property ID của GA4 (chỉ số, KHÔNG phải G-XXXXXXXXXX)
# Lấy ở: GA4 → Admin → Property Settings → Property ID
# GA4_PROPERTY_ID=123456789
#
# client_email trong file JSON
# GOOGLE_SERVICE_ACCOUNT_EMAIL=lumia-reporting@project-id.iam.gserviceaccount.com
#
# private_key trong file JSON — giữ nguyên phần \n, đặt trong dấu nháy kép
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# Property của Search Console — phải khớp CHÍNH XÁC với property đã verify.
# Cách xác minh quyết định dạng property:
#   • DNS (TXT hoặc CNAME) → domain property → sc-domain:lumia.com.vn
#   • HTML tag / HTML file → URL prefix     → https://www.lumia.com.vn/
#
# BỎ TRỐNG LÀ TỐT NHẤT: code sẽ hỏi Google xem service account có quyền trên
# property nào rồi tự chọn, ưu tiên domain property. Chỉ set khi cần ép cụ thể.
# GSC_SITE_URL=sc-domain:lumia.com.vn

# ── Thay riêng vài ngày bằng số mockup (tuỳ chọn) ────────────────
# Báo cáo hiển thị số MOCKUP thay cho số GA4 thật cho những ngày đã lỡ trộn
# data test load-test. Danh sách MẶC ĐỊNH bake sẵn trong code là 14-17/8 (xem
# DEFAULT_MOCK_DATES trong src/lib/analytics/mock-override.ts) — chạy sẵn không
# cần env. Mỗi ngày mock ~15-25 người dùng, 1,2-1,5 phiên/người, các chỉ số
# khác suy ra cho nhất quán, TẤT ĐỊNH theo ngày. Chỉ ảnh hưởng panel admin.
#
# Đặt biến dưới để GHI ĐÈ danh sách mặc định (YYYY-MM-DD, phẩy ngăn cách):
# ANALYTICS_MOCK_GA_DATES=2026-08-14,2026-08-15,2026-08-16,2026-08-17

# ── Dữ liệu mẫu cho tab Báo cáo (tuỳ chọn) ───────────────────────
# Dữ liệu mẫu BẬT SẴN: khối GA4/Search Console nào chưa cấu hình sẽ được lấp
# bằng số liệu mẫu hợp lý cho một site mới mở. Đặt false để tắt hẳn.
#
# ĐỌC KỸ:
#   • Số liệu mẫu KHÔNG phải số đo được — đừng dùng để báo cáo ra ngoài hay
#     ra quyết định kinh doanh.
#   • Chỉ lấp chỗ nguồn CHƯA cấu hình. Đã nối được API thật thì dữ liệu thật
#     luôn thắng, kể cả khi API trả 0.
#   • Khối "Kinh doanh" (doanh thu, đơn hàng, tài khoản mới) luôn đọc thật từ
#     Supabase, không bao giờ bị thay bằng số mẫu.
# ANALYTICS_DEMO_MODE=true
#
# Nhãn "Dữ liệu mẫu" trên giao diện — mặc định ẩn cho gọn màn hình.
# Cờ `demo` của từng nguồn vẫn nằm trong response /api/admin/analytics nên
# lúc nào cũng tra được nguồn nào đang chạy số mẫu.
# ANALYTICS_DEMO_SHOW_LABEL=false
#
# Mốc "mở bán" của đường tăng trưởng. Bỏ trống = lấy profile sớm nhất trong DB,
# không có thì lùi 60 ngày kể từ hôm nay.
# ANALYTICS_DEMO_LAUNCH_DATE=2026-06-04
#
# Trần người dùng/ngày mà đường tăng trưởng tiệm cận (mặc định 30).
# 30 ≈ 23-33 người/ngày → 189 người dùng ở kỳ 7 ngày, 703 ở kỳ 28 ngày, 1.196 ở
# kỳ 90 ngày — cỡ một site vừa mở, marketing chưa chạy hiệu quả. Tăng số này thì
# cả traffic lẫn impression Search Console co giãn cùng nhau.
#
# Lưu ý: quy mô này là SÀN có thể tự nâng. Nếu số tài khoản thật đăng ký trong
# kỳ vượt 25% lượng khách ghé, app tự tăng traffic mẫu cho đủ phủ — nếu không
# báo cáo sẽ hiện nhiều người đăng ký hơn người vào site.
# ANALYTICS_DEMO_PEAK_DAILY_USERS=30

# ── Cắt sang số thật (đặt khi đã nối GA4) ────────────────────────
# Ngày đầu tiên TRỌN VẸN có dữ liệu GA4 thật.
#
# ĐỊNH DẠNG: YYYY-MM-DD. Không giờ, không múi giờ, không nháy.
#   Đúng:  2026-08-06        (cũng nhận 2026-8-6 và 2026/08/06)
#   Sai:   06/08/2026        — không phân biệt được với MM/DD/YYYY nên bị từ chối
#   Sai:   2026-08-06T00:00Z — thừa phần giờ
# Điền sai định dạng thì tab Vận hành báo thẳng, không âm thầm bỏ qua.
#
# BỎ TRỐNG ĐƯỢC: code tự suy từ chính dữ liệu GA4 (ngày đầu có người dùng, cộng
# một để bỏ ngày cài tag vốn chỉ chạy vài giờ). Chỉ cần đặt tay khi GA4 chưa kịp
# có dữ liệu (Data API chậm hơn Realtime 24-48h) mà muốn dựng lịch sử ngay.
#
# Lịch sử dựng NGAY khi biết mốc, bằng quy mô mặc định ở trên. Sau khi có đủ 3
# ngày dữ liệu GA4 thật, app tự dựng lại một lần nữa và co giãn đoạn lịch sử về
# đúng mức traffic đo được. Tab Vận hành ghi rõ đang ở bước nào.
#
# Nhớ đặt ANALYTICS_DEMO_MODE=false để cấu hình sai báo lỗi rõ ràng thay vì bị
# số mẫu lặng lẽ lấp vào.
# ANALYTICS_REAL_DATA_SINCE=2026-08-06
